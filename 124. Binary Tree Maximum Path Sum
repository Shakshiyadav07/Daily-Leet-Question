class Solution {

    int maxSum = INT_MIN;

public:
    int maxPathSum(TreeNode* root) {

        helper(root);

        return maxSum;
    }

    int helper(TreeNode* root) {

        if (root == nullptr)
            return 0;

        int left = max(0, helper(root->left));
        int right = max(0, helper(root->right));

        maxSum = max(maxSum, left + root->val + right);

        return root->val + max(left, right);
    }
};
